# Połączenie aplikacji ze zdalnym PostgreSQL (lub lokalnym w Development).
# W chmurze uwzględnij parametry TLS (?sslmode=require) zgodne z dostawcą.
DATABASE_URL="postgresql://shop_user:shop_password@localhost:5432/shop_db?schema=public"

# Odrębna baza wykorzystywana wyłącznie przez testy integracyjne Vitest i benchmark.
TEST_DATABASE_URL="postgresql://shop_user:shop_password@localhost:5432/shop_test_db?schema=public"

# Maksymalna liczba połączeń w puli pg.Pool na pojedynczy proces serwera (domyślnie 5).
DB_POOL_MAX="5"

# Losowy sekret Better Auth o wysokiej entropii (min. 32 znaki, np. openssl rand -base64 32).
# Dla Production użyj odrębnego sekretu niż w Development.
BETTER_AUTH_SECRET="replace-with-random-secret-at-least-32-characters-long"

# Stały adres bazowy aplikacji:
# - lokalnie: http://localhost:3000
# - Production: https://twoja-nazwa-sklepu.vercel.app
BETTER_AUTH_URL="http://localhost:3000"

# Dane logowania z osobnej aplikacji GitHub OAuth App dla danego środowiska (tylko po stronie serwera, bez NEXT_PUBLIC_).
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"